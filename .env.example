# FintechStocks Environment Configuration

# ─── App ─────────────────────────────────
APP_NAME=FintechStocks
APP_PORT=3000
NODE_ENV=development

# ─── API ─────────────────────────────────
FINTECH_API_URL=https://api.fintechstocks.io/v1
FINTECH_API_KEY=your_api_key_here
API_TIMEOUT=15000

# ─── Cache ───────────────────────────────
# Defaults to ~/.cache/fintechstocks (outside project dir)
# Override with XDG_CACHE_HOME env var
# XDG_CACHE_HOME=/custom/path

# ─── Market Hours ─────────────────────────
MARKET_OPEN=09:00
MARKET_CLOSE=16:30
MARKET_TZ=America/New_York
